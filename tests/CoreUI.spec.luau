-- Remaining core control regressions.
local function coreBox()
    local lib, shell = mount()
    return lib, shell, shell:GetTab("Home"):AddLeftGroupbox("Core")
end
local function pointer(x, y, kind)
    return {
        UserInputType = kind or Enum.UserInputType.MouseButton1,
        KeyCode = Enum.KeyCode.Unknown,
        UserInputState = Enum.UserInputState.Begin,
        Position = { X = x, Y = y },
    }
end
local function key(name)
    return {
        UserInputType = Enum.UserInputType.Keyboard,
        KeyCode = Enum.KeyCode[name],
        UserInputState = Enum.UserInputState.Begin,
    }
end
test("toggle callbacks, checkbox geometry and duplicate rollback", function()
    local lib, shell, box = coreBox()
    local toggle = box:AddCheckbox("bool", { Text = "Enabled", Default = false })
    local size = toggle.Surface.Instance.Size
    local count = 0
    toggle:OnChanged(function()
        count += 1
    end)
    toggle:SetValue(true):SetValue(true):SetDisabled(true)
    toggle.Hit.Activated:Fire()
    assert(toggle.Value and count == 1 and toggle.Surface.Instance.Size == size)
    local children = #box.Elements
    expectError(function()
        box:AddToggle("bool", {})
    end)
    assert(#box.Elements == children)
    toggle:Destroy()
    assert(lib.Toggles.bool == nil and #box.Elements == 0)
    lib:Unload()
end)
test("slider canonical math, limits, entry and pointer sessions at four DPI values", function()
    for _, dpi in { 0.8, 1, 1.25, 1.5 } do
        local lib, shell, box = coreBox()
        lib:SetDPIScale(dpi)
        local slider = box:AddSlider("number", { Min = -1, Max = 1, Default = 0.3, Rounding = 2, Suffix = "%" })
        slider.Track.AbsolutePosition = Vector2.new(100 * dpi, 100 * dpi)
        slider.Track.AbsoluteSize = Vector2.new(200 * dpi, 14 * dpi)
        local down = pointer(250 * dpi, 100 * dpi)
        slider.Track.InputBegan:Fire(down)
        assert(slider.Value == 0.5 and slider._Drag)
        inputService.InputChanged:Fire(pointer(9999, 100 * dpi, Enum.UserInputType.MouseMovement))
        assert(slider.Value == 1)
        inputService.WindowFocusReleased:Fire()
        assert(slider._Drag == nil)
        slider:SetValue(-0.555)
        assert(slider.Value == -0.56)
        slider:SetMin(0):SetMax(0)
        assert(slider.Value == 0 and slider.Fill.Size.X.Scale == 0)
        expectError(function()
            slider:SetValue(0 / 0)
        end)
        expectError(function()
            slider:SetMax(-1)
        end)
        slider.Entry:Focus()
        slider.Entry.Box.Text = "bad"
        slider.Entry:ReleaseFocus()
        assert(slider.Value == 0)
        lib:Unload()
    end
end)
test("key modes, capture suppression, text focus and focus loss", function()
    local lib, shell, box = coreBox()
    local picker = box:AddKeyPicker("key", { Default = "K", Mode = "Hold" })
    local count = 0
    picker:OnActivated(function()
        count += 1
    end)
    inputService.InputBegan:Fire(key("K"), false)
    assert(picker.Active)
    inputService.WindowFocusReleased:Fire()
    assert(not picker.Active)
    picker:SetMode("Toggle")
    inputService.InputBegan:Fire(key("K"), false)
    inputService.InputBegan:Fire(key("K"), false)
    assert(picker.Active)
    inputService.InputEnded:Fire(key("K"))
    inputService.InputBegan:Fire(key("K"), false)
    assert(not picker.Active)
    picker:SetMode("Always")
    assert(picker.Active)
    picker:SetMode("Press")
    local before = count
    inputService.InputBegan:Fire(key("K"), false)
    assert(count == before + 1)
    picker:Capture()
    inputService.InputBegan:Fire(key("RightShift"), false)
    assert(picker.Value == "RightShift" and shell.HostFrame.Visible and not lib.CapturingKey)
    local saved = inputService.GetFocusedTextBox
    inputService.GetFocusedTextBox = function()
        return {}
    end
    inputService.InputBegan:Fire(key("RightShift"), false)
    assert(shell.HostFrame.Visible)
    inputService.GetFocusedTextBox = saved
    picker:Capture()
    inputService.InputBegan:Fire(key("Escape"), false)
    assert(picker.Value == "RightShift" and not picker.Capturing)
    lib:Unload()
end)
test("color popup competes with dropdown and retains focused hex entry", function()
    local lib, shell, box = coreBox()
    local dropdown = box:AddDropdown("choice", { Values = { "One", "Two" } })
    local color = box:AddColorPicker("color", { Default = Color3.new(1, 0, 0), Transparency = 0.25 })
    dropdown:Open()
    color:Open()
    assert(not dropdown.IsOpen and lib.ActivePopup == color.Menu)
    color.Entry:Focus()
    assert(color.IsOpen and color.Entry.Focused)
    color.Entry.Box.Text = "#00FF00"
    color.Entry:ReleaseFocus()
    assert(color.Value == Color3.new(0, 1, 0))
    color.Entry:Focus()
    color.Entry.Box.Text = "invalid"
    color.Entry:ReleaseFocus()
    assert(color.Value == Color3.new(0, 1, 0))
    color:SetTransparency(2)
    assert(color.Transparency == 1)
    box:SetVisible(false)
    assert(not color.IsOpen and not lib.ActivePopup)
    lib:Unload()
end)
test("nested tabs and event driven dependencies release interaction and layout", function()
    local lib, shell, box = coreBox()
    local toggle = box:AddToggle("enabled", {})
    local dep = box:AddDependencyBox():SetupDependencies({ { toggle, true } })
    dep:AddSlider("dependent", { Text = "Conditional", Default = 50 })
    local collapsed = box.Height
    toggle:SetValue(true)
    assert(dep.Visible and box.Height > collapsed)
    toggle:SetValue(false)
    assert(not dep.Visible and box.Height == collapsed)
    local tabs = box:AddTabbox("Nested")
    local first, second = tabs:AddTab("First"), tabs:AddTab("Second")
    local dropdown = first:AddDropdown("nested", { Values = { "A", "B" } })
    second:AddInput("nestedText", { Text = "Searchable" })
    dropdown:Open()
    second:Select()
    assert(not dropdown.IsOpen and tabs.ActiveTab == second)
    second:Destroy()
    assert(tabs.ActiveTab == first)
    toggle:Destroy()
    assert(not dep.Visible)
    lib:Unload()
end)
test("addon ownership, window hide, modal and tooltip cleanup", function()
    local lib, shell, box = coreBox()
    local toggle = box:AddToggle("parent", { Text = "Owner" })
    local binding = toggle:AddKeyPicker("addonKey", {})
    local color = toggle:AddColorPicker("addonColor", {})
    local tip = toggle:SetTooltip("Long tooltip text")
    toggle.Holder.MouseEnter:Fire()
    color:Open()
    color.Entry:Focus()
    local dialog = shell:AddDialog("confirm", { Title = "Confirm", EscapeDismiss = false })
    dialog:Open()
    assert(lib.ActiveModal == dialog and not lib.ActivePopup and not color.Entry.Focused)
    shell:Hide()
    assert(not dialog.IsOpen and not lib.ActiveModal and not lib.ActivePopup)
    shell:Show()
    toggle:Destroy()
    assert(binding.Destroyed and color.Destroyed and tip.Destroyed)
    assert(not lib.Options.addonKey and not lib.Options.addonColor)
    lib:Unload()
    assert(activeConnections() == 0)
end)
test("notification timers and search preserve dependency truth", function()
    local lib, shell, box = coreBox()
    local toggle = box:AddToggle("on", {})
    local dep = box:AddDependencyBox():SetupDependencies({ { toggle, true } })
    local slider = dep:AddSlider("conditional", { Text = "Hidden setting" })
    local results = shell:Search("hidden setting")
    assert(#results == 1 and not results[1]:Navigate() and not dep.Visible)
    toggle:SetValue(true)
    -- Mock does not implement scrolling layout; give the explicit value used by navigation.
    shell.Active.ActiveSub.Content.CanvasPosition = Vector2.zero
    assert(results[1]:Navigate() and slider.Value == 0)
    assert(#shell:Search("") == 0)
    local toast = lib:Notify({ Title = "Saved", Description = string.rep("wrapped ", 30), Time = 2 })
    local persistent = lib:Notify({ Persistent = true })
    toast:Destroy()
    runScheduled()
    assert(toast.Destroyed and not persistent.Destroyed)
    lib:Unload()
    assert(persistent.Destroyed and activeConnections() == 0)
end)
print("Core UI regressions passed")
